{
  "name": "planyatri-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/backend run dev",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "build:web": "npm --prefix apps/web run build",
    "build:api": "npm --prefix apps/backend run build",
    "build": "npm run build:web && npm run build:api",
    "start:web": "npm --prefix apps/web run start",
    "start:api": "npm --prefix apps/backend run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}